PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fila_cabine_votacao

# Admin padrão do sistema (criado no banco ao subir, se ainda não existir)
ADMIN_USER=admin
ADMIN_PASSWORD=cafeseleto1
AUTH_SECRET=troque-este-segredo

CORS_ORIGIN=*
# Fila cheia de pessoas de demonstração ao subir com a fila vazia
SEED_MOCK=false
MOCK_QTD=30
# Quanto tempo (ms, em média) cada pessoa de demonstração leva para votar depois de chamada
MOCK_VOTO_MS=3000
# false: o administrador chama cada pessoa para a cabine. true: chama sozinho quando a cabine libera
CHAMADA_AUTOMATICA=false
